{
	admin off
	auto_https off
	# Set to "on" for production with bigfly.tech
	# auto_https on
}

:80 {
	handle /health {
		respond "OK" 200
	}

	handle /api/v1/* {
		reverse_proxy app:8080 {
			lb_policy round_robin

			health_uri /api/v1/health
			health_interval 10s
			health_timeout 5s

			# Timeouts
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	handle / {
		respond "Baseball API - Use /api/v1/* endpoints" 200
	}

	encode gzip zstd

	log {
		output stdout
		format console
		level INFO
	}
}

